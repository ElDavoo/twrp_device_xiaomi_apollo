--- a/twrpinstall/twinstall.cpp
+++ b/twrpinstall/twinstall.cpp
@@ -65,8 +65,8 @@ enum zip_type {
 	AB_OTA_ZIP_TYPE
 };
 
-// Keeps zips from replacing this recovery on devices with a dedicated recovery
-// partition. LineageOS OTAs, for example, end with
+// Keeps zips from replacing this recovery (or the boot image/kernel) on devices
+// with dedicated recovery/boot partitions. LineageOS OTAs, for example, end with
 // package_extract_file("recovery.img", ".../by-name/recovery").
 //  1. The partition's block device is set read-only (BLKROSET) while the
 //     update binary runs, so every write path to it fails: edify, dd in a
@@ -74,51 +74,59 @@ enum zip_type {
 //  2. Its contents are snapshotted beforehand and compared afterwards; if it
 //     still changed (e.g. a script cleared the read-only flag), the snapshot
 //     is written back.
-// Controlled by tw_protect_recovery (off by default).
-class RecoveryWriteGuard {
+// Controlled by tw_protect_recovery and tw_protect_boot (both off by default).
+class PartitionWriteGuard {
 public:
-	RecoveryWriteGuard() {
-		if (!DataManager::GetIntValue(TW_PROTECT_RECOVERY_VAR)) return;
-		TWPartition* part = PartitionManager.FindPartitionByPath("/recovery");
+	// path: mount point of the partition, var: setting that enables the guard,
+	// msg: prefix of the console messages ("protect_recovery" or "protect_boot").
+	PartitionWriteGuard(const char* path, const char* var, const char* msg)
+		: msg_(msg) {
+		if (!DataManager::GetIntValue(var)) return;
+		TWPartition* part = PartitionManager.FindPartitionByPath(path);
 		if (part == nullptr || part->actual_block_device_.empty()) return;
 		char resolved[PATH_MAX];
 		if (realpath(part->actual_block_device_.c_str(), resolved) == nullptr) {
-			LOGINFO("Recovery guard: cannot resolve '%s'\n", part->actual_block_device_.c_str());
-			gui2_console::log_error("protect_recovery_failed");
+			LOGINFO("Write guard: cannot resolve '%s'\n", part->actual_block_device_.c_str());
+			gui2_console::log_error(Msg("_failed"));
 			return;
 		}
 		device_ = resolved;
 		if (!ReadAll(&snapshot_) || !SetReadOnly(true)) {
 			snapshot_.clear();
-			gui2_console::log_error("protect_recovery_failed");
+			gui2_console::log_error(Msg("_failed"));
 			return;
 		}
 		active_ = true;
-		LOGINFO("Recovery guard: %s read-only, %zu bytes saved\n", device_.c_str(), snapshot_.size());
-		gui2_console::highlight("protect_recovery_active");
+		LOGINFO("Write guard: %s read-only, %zu bytes saved\n", device_.c_str(), snapshot_.size());
+		gui2_console::highlight(Msg("_active"));
 	}
-	~RecoveryWriteGuard() { Finish(); }
+	~PartitionWriteGuard() { Finish(); }
 
 	void Finish() {
 		if (!active_) return;
 		active_ = false;
-		if (!SetReadOnly(false)) LOGINFO("Recovery guard: failed to clear read-only on %s\n", device_.c_str());
+		if (!SetReadOnly(false)) LOGINFO("Write guard: failed to clear read-only on %s\n", device_.c_str());
 		if (Matches()) {
-			LOGINFO("Recovery guard: recovery partition unchanged\n");
+			LOGINFO("Write guard: %s unchanged\n", device_.c_str());
 		} else if (WriteAll() && Matches()) {
-			gui2_console::warning("protect_recovery_restored");
+			gui2_console::warning(Msg("_restored"));
 		} else {
-			gui2_console::log_error("protect_recovery_failed");
+			gui2_console::log_error(Msg("_failed"));
 		}
 		std::string().swap(snapshot_);
 	}
 
 private:
+	const char* Msg(const char* suffix) {
+		msg_key_ = std::string(msg_) + suffix;
+		return msg_key_.c_str();
+	}
+
 	bool SetReadOnly(bool read_only) {
 		android::base::unique_fd fd(open(device_.c_str(), O_RDONLY | O_CLOEXEC));
 		int value = read_only ? 1 : 0;
 		if (fd < 0 || ioctl(fd.get(), BLKROSET, &value) != 0) {
-			LOGINFO("Recovery guard: BLKROSET(%d) on %s failed: %s\n", value, device_.c_str(), strerror(errno));
+			LOGINFO("Write guard: BLKROSET(%d) on %s failed: %s\n", value, device_.c_str(), strerror(errno));
 			return false;
 		}
 		return true;
@@ -152,6 +160,8 @@ private:
 		       fsync(fd.get()) == 0;
 	}
 
+	const char* msg_;
+	std::string msg_key_;
 	std::string device_;
 	std::string snapshot_;
 	bool active_ = false;
@@ -377,7 +387,8 @@ int TWinstall_zip(const char* path, int* wipe_cache, bool check_for_digest) {
 		mkdir("/system", 0755);
 	}
 
-	RecoveryWriteGuard recovery_guard;
+	PartitionWriteGuard recovery_guard("/recovery", TW_PROTECT_RECOVERY_VAR, "protect_recovery");
+	PartitionWriteGuard boot_guard("/boot", TW_PROTECT_BOOT_VAR, "protect_boot");
 	time_t start, stop;
 	time(&start);
 
@@ -437,6 +448,7 @@ int TWinstall_zip(const char* path, int* wipe_cache, bool check_for_digest) {
 		}
 	}
 	recovery_guard.Finish();
+	boot_guard.Finish();
 	time(&stop);
 	int total_time = (int) difftime(stop, start);
 	if (ret_val == INSTALL_CORRUPT) {
