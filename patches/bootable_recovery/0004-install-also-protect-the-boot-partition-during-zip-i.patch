@@ -2912,6 +2914,8 @@ static void rebuild_install_options(void) {
     add(text.general_reflash_twrp, "tw_auto_reflashtwrp", flag("tw_auto_reflashtwrp", 0) != 0);
   if (flag("tw_has_recovery_partition", 0) != 0)
     add(text.general_protect_recovery, "tw_protect_recovery", flag("tw_protect_recovery", 0) != 0);
+  if (flag("tw_has_boot_partition", 0) != 0)
